{
  "name": "@facet-aex/cli",
  "version": "0.4.0",
  "description": "FACET buyer CLI and TypeScript SDK for Avalanche wallet custody, spending policy, discovery, and invocation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-aex/agent-sdk.git"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "facet": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet-store.d.ts",
      "import": "./dist/wallet-store.js"
    },
    "./fuji": {
      "types": "./dist/fuji-wallet.d.ts",
      "import": "./dist/fuji-wallet.js"
    },
    "./policy": {
      "types": "./dist/spend-policy.d.ts",
      "import": "./dist/spend-policy.js"
    },
    "./ledger": {
      "types": "./dist/spend-ledger.d.ts",
      "import": "./dist/spend-ledger.js"
    },
    "./mcp": {
      "types": "./dist/mcp-install.d.ts",
      "import": "./dist/mcp-install.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node --eval \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "viem": "2.57.17"
  }
}
