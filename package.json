{
  "name": "@facet/agent-sdk",
  "version": "0.1.0",
  "description": "FACET TypeScript SDK and CLI for multi-modal discovery, 1-step Actor/Agent publishing, and invocation.",
  "type": "module",
  "private": false,
  "bin": {
    "facet": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
